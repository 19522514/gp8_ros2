<?xml version="1.0" ?>

<robot name="motoman_gp8" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:arg name="robot_name" default="gp8" />
    <xacro:arg name="prefix" default="" />
    <xacro:arg name="add_world" default="true" />
    <xacro:arg name="base_link" default="base_link" />
    <xacro:arg name="base_type" default="g_shape" />
    <xacro:arg name="flange_link" default="flange" />
    <xacro:arg name="gripper_type" default="none" />
    <xacro:arg name="use_camera" default="false" />
    <xacro:arg name="use_gazebo" default="false" />
    <xacro:arg name="use_gripper" default="false" />

    <xacro:if value="$(arg add_world)">
      <link name="world"/>
      <joint name="$(arg prefix)virtual_joint" type="fixed">
          <parent link="world"/>
          <child link="$(arg prefix)$(arg base_link)"/>
          <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>

    <xacro:include filename="$(find gp8_description)/urdf/mech/gp8_macro.xacro" />
    <xacro:motoman_gp8 prefix="$(arg prefix)"/>

    <xacro:include filename="$(find gp8_description)/urdf/control/gazebo_sim_ros2_control.urdf.xacro" />
    <xacro:load_gazebo_sim_ros2_control_plugin
        robot_name="$(arg robot_name)"
        use_gazebo="$(arg use_gazebo)"/>
 
    <xacro:include filename="$(find gp8_description)/urdf/control/gp8_ros2_control.urdf.xacro" />
    <xacro:motoman_gp8_ros2_control
        prefix="$(arg prefix)"
        use_gazebo="$(arg use_gazebo)"/>
    

</robot>
