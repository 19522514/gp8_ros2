<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:property name="joint_damping" value="0.0"/>
  <xacro:property name="joint_friction" value="0.0"/>

  <xacro:macro name="motoman_gp8" params="prefix">
    <xacro:include filename="$(find gp8_description)/urdf/resources/common_materials.xacro"/>

    <!-- link list -->
    <link name="${prefix}base_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/visual/gp8_base_link.stl"/>
        </geometry>
        <xacro:material_yaskawa_blue/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/collision/gp8_base_link.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <mass value="12.0"/>
        <inertia ixx="0.157" ixy="0.0" ixz="0.0" iyy="0.157" iyz="0.0" izz="0.135"/>
      </inertial>
    </link>

    <link name="${prefix}link_1_s">
      <visual>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/visual/gp8_link_1_s.stl"/>
        </geometry>
        <xacro:material_yaskawa_blue/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/collision/gp8_link_1_s.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.02 0 0.15" rpy="0 0 0"/>
        <mass value="8.0"/>
        <inertia ixx="0.088" ixy="0.0" ixz="0.0" iyy="0.088" iyz="0.0" izz="0.057"/>
      </inertial>
    </link>

    <link name="${prefix}link_2_l">
      <visual>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/visual/gp8_link_2_l.stl"/>
        </geometry>
        <xacro:material_yaskawa_blue/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/collision/gp8_link_2_l.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.17" rpy="0 0 0"/>
        <mass value="6.0"/>
        <inertia ixx="0.076" ixy="0.0" ixz="0.0" iyy="0.076" iyz="0.0" izz="0.030"/>
      </inertial>
    </link>

    <link name="${prefix}link_3_u">
      <visual>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/visual/gp8_link_3_u.stl"/>
        </geometry>
        <xacro:material_yaskawa_blue/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/collision/gp8_link_3_u.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.17 0 0.02" rpy="0 0 0"/>
        <mass value="4.0"/>
        <inertia ixx="0.047" ixy="0.0" ixz="0.0" iyy="0.047" iyz="0.0" izz="0.012"/>
      </inertial>
    </link>

    <link name="${prefix}link_4_r">
      <visual>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/visual/gp8_link_4_r.stl"/>
        </geometry>
        <xacro:material_yaskawa_blue/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/collision/gp8_link_4_r.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.006" ixy="0.0" ixz="0.0" iyy="0.006" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <link name="${prefix}link_5_b">
      <visual>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/visual/gp8_link_5_b.stl"/>
        </geometry>
        <xacro:material_yaskawa_blue/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/collision/gp8_link_5_b.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0007" ixy="0.0" ixz="0.0" iyy="0.0007" iyz="0.0" izz="0.0006"/>
      </inertial>
    </link>

    <link name="${prefix}link_6_t">
      <visual>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/visual/gp8_link_6_t.stl"/>
        </geometry>
        <xacro:material_yaskawa_blue/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find gp8_description)/meshes/gp8/collision/gp8_link_6_t.stl"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.02 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.0004" ixy="0.0" ixz="0.0" iyy="0.0004" iyz="0.0" izz="0.0006"/>
      </inertial>
    </link>
    <!-- end of link list -->

    <!-- joint list -->
    <joint name="${prefix}joint_1_s" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1_s"/>
      <origin xyz="0 0 0.330" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="${radians(-170)}" upper="${radians(170)}" effort="150.92" velocity="${radians(455)}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <joint name="${prefix}joint_2_l" type="revolute">
      <parent link="${prefix}link_1_s"/>
      <child link="${prefix}link_2_l"/>
      <origin xyz="0.040 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit lower="${radians(-65)}" upper="${radians(145)}" effort="176.4" velocity="${radians(385)}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <joint name="${prefix}joint_3_u" type="revolute">
      <parent link="${prefix}link_2_l"/>
      <child link="${prefix}link_3_u"/>
      <origin xyz="0 0 0.345" rpy="0 0 0" />
      <axis xyz="0 -1 0" />
      <limit lower="${radians(-70)}" upper="${radians(190)}" effort="107.56" velocity="${radians(520)}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <joint name="${prefix}joint_4_r" type="revolute">
      <parent link="${prefix}link_3_u"/>
      <child link="${prefix}link_4_r"/>
      <origin xyz="0.340 0 0.040" rpy="0 0 0" />
      <axis xyz="-1 0 0" />
      <limit lower="${radians(-190)}" upper="${radians(190)}" effort="55.86" velocity="${radians(550)}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <joint name="${prefix}joint_5_b" type="revolute">
      <parent link="${prefix}link_4_r"/>
      <child link="${prefix}link_5_b"/>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="0 -1 0" />
      <limit lower="${radians(-135)}" upper="${radians(135)}" effort="32.68" velocity="${radians(550)}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <joint name="${prefix}joint_6_t" type="revolute">
      <parent link="${prefix}link_5_b"/>
      <child link="${prefix}link_6_t"/>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="-1 0 0" />
      <limit lower="${radians(-360)}" upper="${radians(360)}" effort="22.54" velocity="${radians(1000)}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>
    <!-- end of joint list -->

    <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
    <link name="${prefix}flange"/>
    <joint name="${prefix}joint_6_t-flange" type="fixed">
      <origin xyz="0.080 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_6_t"/>
      <child link="${prefix}flange"/>
    </joint>

    <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
    <link name="${prefix}tool0"/>
    <joint name="${prefix}flange-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="${radians(180)} ${radians(-90)} 0"/>
      <parent link="${prefix}flange"/>
      <child link="${prefix}tool0"/>
    </joint>

    <!-- ROS base_link to Robot Manufacturer World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0.330" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

  </xacro:macro>
</robot>
